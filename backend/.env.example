# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Deployment (solo producción; en dev se dejan como están) ---
# SERVE_STATIC=true  -> Express sirve el build del SPA desde STATIC_DIR y se
# desactiva CORS (mismo origen). La imagen de Docker ya los define.
# SERVE_STATIC=false
# STATIC_DIR=public
# Cantidad de proxies delante de la app (Railway/Render = 1). Necesario para
# el rate limiter y para que las cookies `secure` funcionen detrás del proxy.
# TRUST_PROXY=0
# SameSite de la cookie de refresh. 'strict' sirve cuando el SPA se sirve
# desde el mismo dominio que la API (deploy por defecto). Usar 'none' solo si
# el frontend queda en otro dominio: exige HTTPS y los navegadores que
# bloquean cookies de terceros (Safari) igual la van a rechazar.
# COOKIE_SAMESITE=strict

# --- Database (MySQL Server 8.0.16+) ---
DATABASE_URL="mysql://root:password@localhost:3306/logistics_management?allowPublicKeyRetrieval=true"

# --- Auth (JWT) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-96-hex-chars
JWT_REFRESH_SECRET=replace-with-another-random-96-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Driver password encryption (A-9) ---
# AES-256-GCM key, exactly 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENCRYPTION_KEY=replace-with-random-64-hex-chars

# --- Email / credentials delivery (DOC-1) ---
# All optional. Without SMTP_HOST the mailer runs in dev mode: it builds the
# message and logs it, but does NOT send (no SMTP server needed for dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=secret
MAIL_FROM="Gestión Logística <no-reply@empresa.com>"
APP_URL=http://localhost:5173
