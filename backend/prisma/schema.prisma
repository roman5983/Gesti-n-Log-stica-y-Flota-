// Logistics & Fleet Management System — Prisma schema
// Mirrors the reference DDL (docs/schema.sql). CHECK constraints are not
// expressible in Prisma: they are added via raw SQL in migrations and
// re-validated in the service layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums (closed domains from the functional document: C-1, A-2, C-6)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  OPERATOR
  DRIVER
}

enum LicenseCategory {
  A
  B
  C
  E
}

enum DocumentType {
  DNI
  LICENSE
  ART
  PSYCHOPHYSICAL
}

enum VehicleStatus {
  AVAILABLE
  INACTIVE
  IN_WORKSHOP
  ON_TRIP
}

enum TripStatus {
  PENDING_ASSIGNMENT
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum AlertStatus {
  PENDING
  RESOLVED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(100)
  email        String    @unique(map: "uq_users_email") @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(60)
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  driver         Driver?
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  createdTrips   Trip[]         @relation("TripOperator")
  finishedTrips  Trip[]         @relation("TripFinishedBy")
  resolvedAlerts Alert[]        @relation("AlertResolvedBy")

  @@index([role, isActive], map: "idx_users_role_active")
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  tokenHash String   @unique(map: "uq_refresh_tokens_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_refresh_tokens_user")

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model Driver {
  userId            Int             @id @map("user_id") @db.UnsignedInt
  dni               String          @unique(map: "uq_drivers_dni") @db.VarChar(10)
  licenseCategory   LicenseCategory @map("license_category")
  licenseExpiryDate DateTime        @map("license_expiry_date") @db.Date
  encryptedPassword String          @map("encrypted_password") @db.VarChar(255)
  completedTrips    Int             @default(0) @map("completed_trips") @db.UnsignedInt
  avgKm             Decimal         @default(0) @map("avg_km") @db.Decimal(10, 2)

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, map: "fk_drivers_user")
  documents DriverDocument[]
  trips     Trip[]

  @@index([licenseExpiryDate], map: "idx_drivers_license_expiry")
  @@map("drivers")
}

model DriverDocument {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  driverId     Int          @map("driver_id") @db.UnsignedInt
  documentType DocumentType @map("document_type")
  expiryDate   DateTime     @map("expiry_date") @db.Date
  fileName     String       @map("file_name") @db.VarChar(255)
  filePath     String       @map("file_path") @db.VarChar(500)
  mimeType     String       @map("mime_type") @db.VarChar(50)
  fileSize     Int          @map("file_size") @db.UnsignedInt
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  deletedAt    DateTime?    @map("deleted_at")

  driver Driver @relation(fields: [driverId], references: [userId], onDelete: Restrict, map: "fk_driver_documents_driver")

  @@index([driverId], map: "idx_driver_documents_driver")
  @@index([expiryDate], map: "idx_driver_documents_expiry")
  @@map("driver_documents")
}

model Vehicle {
  id                  Int           @id @default(autoincrement()) @db.UnsignedInt
  licensePlate        String        @unique(map: "uq_vehicles_plate") @map("license_plate") @db.VarChar(10)
  model               String        @db.VarChar(100)
  year                Int           @db.UnsignedSmallInt
  initialKm           Int           @map("initial_km") @db.UnsignedInt
  accumulatedKm       Int           @map("accumulated_km") @db.UnsignedInt
  lastMaintenanceDate DateTime?     @map("last_maintenance_date") @db.Date
  insuranceExpiryDate DateTime?     @map("insurance_expiry_date") @db.Date
  status              VehicleStatus @default(AVAILABLE)
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  trips        Trip[]
  maintenances Maintenance[]

  @@index([status], map: "idx_vehicles_status")
  @@index([insuranceExpiryDate], map: "idx_vehicles_insurance_expiry")
  @@map("vehicles")
}

model MaintenanceType {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  name         String  @unique(map: "uq_maintenance_types_name") @db.VarChar(50)
  description  String  @db.VarChar(255)
  kmAlert      Int     @map("km_alert") @db.UnsignedInt
  kmTarget     Int     @map("km_target") @db.UnsignedInt
  monthsAlert  Int?    @map("months_alert") @db.UnsignedTinyInt
  monthsTarget Int?    @map("months_target") @db.UnsignedTinyInt

  maintenances Maintenance[]

  @@map("maintenance_types")
}

model Maintenance {
  id                Int               @id @default(autoincrement()) @db.UnsignedInt
  vehicleId         Int               @map("vehicle_id") @db.UnsignedInt
  maintenanceTypeId Int               @map("maintenance_type_id") @db.UnsignedInt
  status            MaintenanceStatus @default(PENDING)
  scheduledAt       DateTime          @map("scheduled_at")
  completedAt       DateTime?         @map("completed_at")
  km                Int               @db.UnsignedInt
  notes             String?           @db.Text
  nextMaintenanceKm Int?              @map("next_maintenance_km") @db.UnsignedInt
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  vehicle         Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict, map: "fk_maintenances_vehicle")
  maintenanceType MaintenanceType         @relation(fields: [maintenanceTypeId], references: [id], onDelete: Restrict, map: "fk_maintenances_type")
  attachments     MaintenanceAttachment[]

  @@index([vehicleId, status], map: "idx_maintenances_vehicle_status")
  @@index([status], map: "idx_maintenances_status")
  @@index([scheduledAt], map: "idx_maintenances_scheduled")
  @@map("maintenances")
}

model MaintenanceAttachment {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  maintenanceId Int      @map("maintenance_id") @db.UnsignedInt
  fileName      String   @map("file_name") @db.VarChar(255)
  filePath      String   @map("file_path") @db.VarChar(500)
  mimeType      String   @map("mime_type") @db.VarChar(50)
  fileSize      Int      @map("file_size") @db.UnsignedInt
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade, map: "fk_maintenance_attachments_maintenance")

  @@index([maintenanceId], map: "idx_maintenance_attachments_maintenance")
  @@map("maintenance_attachments")
}

model Trip {
  id                  Int        @id @default(autoincrement()) @db.UnsignedInt
  origin              String     @default("Ciudad Industria, Autopista Córdoba - Rosario, Rosario, Santa Fe") @db.VarChar(120)
  destination         String     @db.VarChar(120)
  departureAt         DateTime   @map("departure_at")
  status              TripStatus @default(PENDING_ASSIGNMENT)
  estimatedDistanceKm Decimal?   @map("estimated_distance_km") @db.Decimal(8, 2)
  estimatedTimeMin    Int?       @map("estimated_time_min") @db.UnsignedInt
  notes               String?    @db.Text
  operatorId          Int        @map("operator_id") @db.UnsignedInt
  driverId            Int?       @map("driver_id") @db.UnsignedInt
  vehicleId           Int?       @map("vehicle_id") @db.UnsignedInt
  departureKm         Int?       @map("departure_km") @db.UnsignedInt
  arrivalKm           Int?       @map("arrival_km") @db.UnsignedInt
  assignedAt          DateTime?  @map("assigned_at")
  finishedAt          DateTime?  @map("finished_at")
  finishedById        Int?       @map("finished_by_id") @db.UnsignedInt
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  operator   User     @relation("TripOperator", fields: [operatorId], references: [id], onDelete: Restrict, map: "fk_trips_operator")
  driver     Driver?  @relation(fields: [driverId], references: [userId], onDelete: Restrict, map: "fk_trips_driver")
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict, map: "fk_trips_vehicle")
  finishedBy User?    @relation("TripFinishedBy", fields: [finishedById], references: [id], onDelete: Restrict, map: "fk_trips_finished_by")

  @@index([status], map: "idx_trips_status")
  @@index([departureAt], map: "idx_trips_departure")
  @@index([driverId, status], map: "idx_trips_driver_status")
  @@index([vehicleId, status], map: "idx_trips_vehicle_status")
  @@index([operatorId], map: "idx_trips_operator")
  @@map("trips")
}

model Alert {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  alertType    String      @map("alert_type") @db.VarChar(50)
  description  String      @db.VarChar(255)
  entityType   String      @map("entity_type") @db.VarChar(30)
  entityId     Int         @map("entity_id") @db.UnsignedInt
  raisedAt     DateTime    @default(now()) @map("raised_at")
  status       AlertStatus @default(PENDING)
  resolvedById Int?        @map("resolved_by_id") @db.UnsignedInt
  resolvedAt   DateTime?   @map("resolved_at")

  resolvedBy User? @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, map: "fk_alerts_resolved_by")

  @@index([status, raisedAt], map: "idx_alerts_status_raised")
  @@index([entityType, entityId], map: "idx_alerts_entity")
  @@map("alerts")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       Int      @map("user_id") @db.UnsignedInt
  action       String   @db.VarChar(30)
  entity       String   @db.VarChar(30)
  entityId     Int?     @map("entity_id") @db.UnsignedInt
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  previousData Json?    @map("previous_data")
  newData      Json?    @map("new_data")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, map: "fk_audit_logs_user")

  @@index([userId, occurredAt], map: "idx_audit_logs_user_date")
  @@index([entity, entityId], map: "idx_audit_logs_entity")
  @@index([occurredAt], map: "idx_audit_logs_date")
  @@map("audit_logs")
}

model CompanySettings {
  id          Int      @id @default(1) @db.UnsignedTinyInt
  companyName String   @map("company_name") @db.VarChar(150)
  taxId       String   @map("tax_id") @db.VarChar(13)
  address     String   @db.VarChar(200)
  phone       String   @db.VarChar(30)
  email       String   @db.VarChar(150)
  timezone    String   @default("America/Argentina/Cordoba") @db.VarChar(50)
  language    String   @default("es-AR") @db.VarChar(10)
  dateFormat  String   @default("DD/MM/YYYY") @map("date_format") @db.VarChar(20)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}
