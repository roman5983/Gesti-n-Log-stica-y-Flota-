# Base URL of the backend API. Optional: by default the app calls /api/v1 on
# its own origin, which Vite (dev) and Vercel (production) forward to the
# backend. Set it only to bypass that proxy (the backend must then allow this
# origin in CORS_ORIGIN, and the session will not survive reloads in browsers
# that block third-party cookies).
# VITE_API_URL=http://localhost:3000/api/v1

# Optional: Google Maps API key to embed the trip route map (C-3).
# Without it, the app shows a "Ver recorrido en Google Maps" link instead.
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
